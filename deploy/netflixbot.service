[Unit]
Description=Netflix Login Bot (Telegram + SePay webhook)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/bot_netflix
EnvironmentFile=-/root/bot_netflix/.env.bot
ExecStart=/root/bot_netflix/.venv/bin/python3 -u main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
